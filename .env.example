NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# long random string: openssl rand -hex 32
JWT_SECRET=change-me
# optional, enables /api/admin/* (min 16 chars): openssl rand -hex 24
ADMIN_TOKEN=
# comma separated, only if the frontend is served from another domain
CORS_ORIGINS=
# set to 1 behind nginx/caddy so rate limiting sees the real IP
TRUST_PROXY=1
DATA_DIR=./data
SESSION_DAYS=30
MAX_BODY=15mb
KEEP_HISTORY=200
# max size of the automatic snapshots per school (MB)
HISTORY_MAX_MB=100
# failed sign-ins: per IP / per username, per 15 min
LOGIN_PER_15MIN=10
LOGIN_PER_ACCOUNT_15MIN=30
SNAPSHOT_EVERY_MIN=10

# the school this install serves (default: SEED_SCHOOL_CODE, else the first active school)
DEFAULT_SCHOOL_CODE=
# first-run seed (optional)
SEED_SCHOOL_CODE=
SEED_SCHOOL_NAME=
SEED_SCHOOL_PASSWORD=

# Forgot-password emails (Gmail). The user sets SMTP_PASS (App Password) in Railway himself.
# If SMTP_PASS is empty, the app stays up: the request still returns a generic message and no email is sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=contact.otoqol@gmail.com
SMTP_PASS=
MAIL_FROM=Otoqol <contact.otoqol@gmail.com>
# optional limits (defaults shown)
# FORGOT_PER_15MIN=5
# FORGOT_PER_ACCOUNT_15MIN=3
# RESET_PER_15MIN=10
# RESET_CODE_TTL_MS=900000
# RESET_MAX_ATTEMPTS=5
